flowchart TD
    %% ---------- Input ----------
    CSV[("songs CSV file")] --> LOAD["load_songs(csv_path)<br/>strip whitespace, cast id/energy/tempo/<br/>valence/acousticness to numbers"]
    LOAD --> SONGS["List of song dicts"]
    PREFS["User preferences dict<br/>favorite_genres, favorite_mood,<br/>target_energy, likes_acoustic"]

    %% ---------- OOP entry point ----------
    subgraph OOP["Recommender class (OOP wrapper)"]
        direction TB
        RINIT["Recommender(songs: List[Song])<br/>_check_duplicates on init"]
        RREC["recommend(user, k)<br/>converts dataclasses to dicts"]
        RMAP["Map ranked dicts back<br/>to Song objects by id"]
        REXP["explain_recommendation(user, song)<br/>'Score X.XX/9.00: reasons'"]
        RINIT --> RREC
    end

    SONGS --> REC
    PREFS --> REC
    RREC --> REC
    REXP --> SCORE

    %% ---------- recommend_songs ----------
    subgraph RS["recommend_songs(user_prefs, songs, k)"]
        direction TB
        REC{"k < 0?"}
        REC -- yes --> NEG["Print warning,<br/>return []"]
        REC -- no --> DUP{"_check_duplicates<br/>duplicate id or<br/>title + artist?"}
        DUP -- yes --> ERR1["Raise ValueError"]
        DUP -- no --> LOOP["For each song"]
        COLLECT["Append (song, score, reasons joined by '; ')"]
        COLLECT -->|next song| LOOP
        COLLECT -->|all scored| SORT["Sort by:<br/>1. score (high to low)<br/>2. closer energy to target<br/>3. lower id"]
        SORT --> TOPK["Return top k results"]
    end

    %% ---------- score_song ----------
    subgraph SS["score_song(user_prefs, song)  (max 9.0)"]
        direction TB
        SCORE["Build UserProfile(**user_prefs)"] --> VALID{"Valid profile?<br/>1 to 3 genres, likes_acoustic is<br/>bool/None, energy not NaN"}
        VALID -- no --> ERR2["Raise ValueError / TypeError"]
        VALID -- yes --> NORM["Normalize genres + mood<br/>(lowercase, collapse spaces, dedupe)<br/>clamp target_energy to 0..1"]

        NORM --> G{"_match_genre:<br/>exact match, or all words of a<br/>favorite appear in song genre?"}
        G -- yes --> GP["+4.0 genre points"]
        G -- no --> M
        GP --> M{"Song mood ==<br/>favorite_mood?"}
        M -- yes --> MP["+2.0 mood points"]
        M -- no --> E
        MP --> E["Energy points:<br/>max(0, 2.0 × (1 − |song energy − target|))"]
        E --> A{"likes_acoustic<br/>is None?"}
        A -- yes --> OUT
        A -- "True" --> AT["+1.0 × acousticness (clamped)"]
        A -- "False" --> AF["+1.0 × (1 − acousticness) (clamped)"]
        AT --> OUT
        AF --> OUT
        OUT["Return (score, reasons list)"]
    end

    %% ---------- Cross-function links ----------
    LOOP --> SCORE
    OUT --> COLLECT
    TOPK --> RMAP
    TOPK --> RESULT["Ranked recommendations<br/>(song, score, explanation)"]
    RMAP --> RESULT2["List of Song objects"]
