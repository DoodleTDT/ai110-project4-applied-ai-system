flowchart TD
    %% =====================================================================
    %% MusicMatchMaker - RAG version (draft)
    %% Based on diagrams/tentative_plan.md. New components are in the
    %% Parse, Retrieval, Coverage, External, Guardrails, Review and Output
    %% subgraphs. The scorer (recommend_songs + score_song) is reused as-is,
    %% except _match_genre now goes through GenreTaxonomy.
    %% =====================================================================

    %% ---------- Data stores (SQLite .db3) ----------
    SONGSDB[("songs table<br/>approved songs only")]
    PENDINGDB[("pending_songs table<br/>confidence, estimated_fields,<br/>verified, deezer_id")]
    CACHEDB[("external_cache table<br/>cached Last.fm / Deezer results")]

    %% ---------- One-time seed ----------
    subgraph SEED["scripts/seed_db.py: seed_from_csv(csv_path, db, deezer)"]
        direction TB
        CSV[("data/songs.csv<br/>(unchanged, still used by tests)")] --> LOAD["load_songs(csv_path)"]
        LOAD --> SEEDCHK["DeezerClient.search(title, artist)<br/>record verified true/false + deezer_id"]
        SEEDCHK --> SEEDADD["SongDatabase.add_pending(song)<br/>source = 'seed_csv'"]
    end
    SEEDADD --> PENDINGDB

    %% ---------- Parse ----------
    subgraph PARSE["Step 1: RequestParser (llm.py, small Claude model)"]
        direction TB
        REQ["User types a playlist description<br/>e.g. 'rainy Sunday study playlist, a little jazzy'"]
        REQ --> PARSEFN["RequestParser.parse(text)<br/>Claude tool use returns structured prefs"]
        PARSEFN --> CANON["GenreTaxonomy.canonical(label)<br/>map each genre onto the controlled list"]
        CANON --> PROFILE["UserProfile<br/>favorite_genres, favorite_mood,<br/>target_energy, likes_acoustic"]
    end

    %% ---------- Agent orchestration ----------
    AGENT["PlaylistAgent.run(request, k)<br/>tools: search_local_db, search_external,<br/>propose_song_addition"]
    AGENT --> REQ

    %% ---------- Retrieval ----------
    subgraph RETRIEVE["Step 2: Local retrieval (tool: search_local_db)"]
        direction TB
        GETSONGS["SongDatabase.get_songs()"]
        CANDS["Candidate list<br/>approved songs + verified pending songs"]
        GETSONGS --> CANDS
    end
    SONGSDB --> GETSONGS
    PENDINGDB -. "verified pending songs<br/>(flagged 'new, pending review')" .-> CANDS
    PROFILE --> REC
    CANDS --> REC

    %% ---------- recommend_songs (reused) ----------
    subgraph RS["recommend_songs(user_prefs, songs, k)  (reused)"]
        direction TB
        REC{"k < 0?"}
        REC -- yes --> NEG["Print warning,<br/>return []"]
        REC -- no --> DUP{"_check_duplicates<br/>duplicate id or<br/>title + artist?"}
        DUP -- yes --> ERR1["Raise ValueError"]
        DUP -- no --> LOOP["For each song"]
        COLLECT["Append (song, score, reasons joined by '; ')"]
        COLLECT -->|next song| LOOP
        COLLECT -->|all scored| SORT["Sort by:<br/>1. score (high to low)<br/>2. closer energy to target<br/>3. lower id"]
        SORT --> TOPK["Return top k results"]
    end

    %% ---------- score_song (reused) ----------
    subgraph SS["score_song(user_prefs, song)  (max 9.0, fixed weights in v1)"]
        direction TB
        SCORE["Build UserProfile(**user_prefs)"] --> VALID{"Valid profile?<br/>1 to 3 genres, likes_acoustic is<br/>bool/None, energy not NaN"}
        VALID -- no --> ERR2["Raise ValueError / TypeError"]
        VALID -- yes --> NORM["Normalize genres + mood<br/>(lowercase, collapse spaces, dedupe)<br/>clamp target_energy to 0..1"]

        NORM --> G{"_match_genre via<br/>GenreTaxonomy.matches(favorites, song_genre)<br/>same genre or same parent<br/>(metal → rock, indie pop → pop)?"}
        G -- yes --> GP["+4.0 genre points"]
        G -- no --> M
        GP --> M{"Song mood ==<br/>favorite_mood?"}
        M -- yes --> MP["+2.0 mood points"]
        M -- no --> E
        MP --> E["Energy points:<br/>max(0, 2.0 × (1 − |song energy − target|))"]
        E --> A{"likes_acoustic<br/>is None?"}
        A -- yes --> OUT
        A -- "True" --> AT["+1.0 × acousticness (clamped)"]
        A -- "False" --> AF["+1.0 × (1 − acousticness) (clamped)"]
        AT --> OUT
        AF --> OUT
        OUT["Return (score, reasons list)"]
    end

    LOOP --> SCORE
    OUT --> COLLECT

    %% ---------- Coverage check ----------
    TOPK --> COV{"Step 3: CoverageChecker.needs_external()<br/>fewer than k songs score ≥ 6/9, or a<br/>requested genre has fewer than N songs?<br/>(and external search not run yet)"}

    %% ---------- External search ----------
    subgraph EXT["Step 4: External search (tool: search_external, external.py)"]
        direction TB
        TARGET["CoverageChecker.target_genres(profile, genre_counts)<br/>prefer genres with few songs (fixes pop bias)"]
        TARGET --> LFM["LastFmClient<br/>tag_top_tracks(tag, limit)<br/>similar_tracks(title, artist)<br/>top_tags(title, artist)<br/>(API key from .env)"]
        LFM --> DZ["DeezerClient.search(title, artist)<br/>id, bpm (0 → missing), preview_url"]
        DZ --> VIBE["VibeEstimator.estimate(title, artist, tags)<br/>LLM estimates energy, valence,<br/>acousticness, mood, genre<br/>→ listed in estimated_fields"]
    end
    COV -- yes --> TARGET
    GENRECOUNT["SongDatabase.genre_counts()"] --> TARGET
    LFM -. "cache_get / cache_put" .- CACHEDB
    DZ -. "cache_get / cache_put" .- CACHEDB

    %% ---------- Guardrails ----------
    subgraph GUARD["Step 4b: Guardrails (validation.py, tool: propose_song_addition)"]
        direction TB
        VERIFY{"SongValidator.verify(candidate)<br/>title + artist match a<br/>Deezer result?"}
        VERIFY -- no --> DROP1["Drop song<br/>(counted for hallucination rate)"]
        VERIFY -- yes --> SCHEMA{"SongValidator.validate_schema(song)<br/>energy/valence/acousticness in 0..1,<br/>GenreTaxonomy.is_allowed(genre)?"}
        SCHEMA -- no --> DROP2["Drop song"]
        SCHEMA -- yes --> DEDUPE{"SongValidator.is_duplicate(song, existing)<br/>uses _normalize + _check_duplicates,<br/>mbid if present"}
        DEDUPE -- yes --> DROP3["Skip (already known)"]
        DEDUPE -- no --> CONF["SongValidator.confidence(song)"]
        CONF --> STAGE["SongDatabase.add_pending(song)<br/>source, added_at, confidence,<br/>estimated_fields"]
    end
    VIBE --> VERIFY
    STAGE --> PENDINGDB

    %% ---------- Merge and re-rank ----------
    STAGE --> MERGE["Step 5: Merge local + new verified songs<br/>new songs flagged 'new, pending review'"]
    MERGE -- "re-rank with same scorer" --> REC

    %% ---------- Output ----------
    subgraph OUTPUT["Step 5b: Output (llm.py)"]
        direction TB
        WRITE["PlaylistWriter.write(ranked)<br/>one reason per song, citing<br/>retrieved data only (no songs from memory)"]
        WRITE --> RESULT["Final playlist<br/>(song, score, reason, source,<br/>'new, pending review' flag)"]
    end
    COV -- "no / already searched" --> WRITE

    %% ---------- Manual review (Streamlit app.py) ----------
    subgraph REVIEW["Review panel (app.py, Streamlit) - v1 manual approval only"]
        direction TB
        LIST["SongDatabase.list_pending()<br/>shows confidence + estimated_fields"]
        LIST --> DECIDE{"Approve or Reject?"}
        DECIDE -- approve --> APPROVE["SongDatabase.approve(pending_id)<br/>one transaction: insert into songs,<br/>delete from pending_songs"]
        DECIDE -- reject --> REJECT["SongDatabase.reject(pending_id)"]
    end
    PENDINGDB --> LIST
    APPROVE --> SONGSDB
    REJECT --> PENDINGDB

    %% ---------- Logging ----------
    LOGGER["AgentLogger.log_step(step, payload)<br/>query, retrieved items, added songs<br/>→ ai_interactions.md / model card"]
    PARSEFN -.-> LOGGER
    CANDS -.-> LOGGER
    LFM -.-> LOGGER
    STAGE -.-> LOGGER
    RESULT -.-> LOGGER
